# The shop runs with no configuration at all.

# Storage. Unset, the app uses a JSON file at data/db.json — zero setup, and
# single-process only, so it is for local work and demos rather than traffic.
# Set this and it uses Postgres instead; the schema is applied on first use.
# DATABASE_URL=postgres://user:password@localhost:5432/blindbox

# Password for the inventory console at /admin.
# Unset, the console is open in development and refuses to load in production —
# an unprotected inventory editor should never be the accidental default.
# ADMIN_PASSWORD=

# When you replace the mock payment provider in src/lib/payments.ts with a real
# one, its keys belong here — for Stripe, that is the pair below.
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
